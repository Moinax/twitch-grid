{
  "name": "twitch-grid",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "test": "playwright test",
    "check": "tsc --noEmit && node --check api/stream.js && node --check api/search.js && node --check server.cjs",
    "dev": "node --env-file-if-exists=.env.local server.cjs",
    "og:generate": "node scripts/render-share-image.cjs",
    "test:server": "node --test tests/stream.test.cjs tests/search.test.cjs tests/i18n.test.cjs",
    "build": "pnpm check && vite build",
    "preview": "vite preview --host localhost --port 8765",
    "format": "prettier --write src vite.config.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "hls.js": "^1.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "engines": {
    "node": ">=24"
  }
}
